# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
app-*.tar

# If NPM crashes, it generates a log, let's ignore it too.
npm-debug.log

# The directory NPM downloads your dependencies sources to.
node_modules

# Since we are building assets from assets/,
# we ignore priv/static. You may want to comment
# this depending on your deployment strategy.
/priv/static/

/tmp

# Secrets are injected at run time by `infisical run` — no .env files at rest.
# Any `.env.*` (legacy private files, the soon-to-be-removed `_private` symlinks,
# `.env.prod`) stays ignored.
/.env.*

# Worktrunk writes this per worktree (randomized ports as a mise [env] override).
/mise.local.toml

# Historical port files should be generated by mise/Worktrunk, not restored as
# private-volume symlinks.
/.port
/.port.test
/.port.pgweb

# Keep local REPL customizations out of the repo unless they are explicitly
# scrubbed and useful to everyone.
/.iex.exs
